<UserControl x:Class="TecSight.App.Pages.OverviewPage" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource BgBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="{Binding Snapshot.Inventory.ComputerName}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Snapshot.Inventory.OsCaption}" Margin="14,6,0,0" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Loc[Overview.Refreshing]}" Margin="14,6,0,0" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Cards" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8" Padding="14" CornerRadius="8" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>