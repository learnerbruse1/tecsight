<Window x:Class="TecSight.App.MainWindow" Icon="Assets/tecsight.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TecSight" Height="700" Width="1100" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen" FontSize="13"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBgBrush}" Padding="14,8">
            <DockPanel>
                <TextBlock Text="{Binding Loc[App.Title]}" Foreground="{DynamicResource HeaderFgBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Content="🌙" Click="ThemeButton_Click" Margin="0,0,10,0" Padding="10,4" ToolTip="{Binding Loc[Common.Theme]}"/>
                    <Button x:Name="AdminRestartButton" Content="{Binding Loc[Common.RestartAsAdmin]}" Click="AdminRestart_Click" Margin="0,0,10,0" Padding="8,4"/>
                    <Button x:Name="LangButton" Content="{Binding Loc[Nav.LangToggle]}" Click="LangButton_Click" Margin="0,0,10,0" Padding="8,4"/>
                    <Menu VerticalAlignment="Center" Background="Transparent">
                        <MenuItem Header="{Binding Loc[Export.Menu]}" Padding="8,4">
                            <MenuItem Header="{Binding Loc[Export.Copy]}" Click="CopySummary_Click"/>
                            <MenuItem Header="{Binding Loc[Export.Json]}" Click="ExportJson_Click"/>
                            <MenuItem Header="{Binding Loc[Export.Txt]}" Click="ExportTxt_Click"/>
                            <MenuItem Header="{Binding Loc[Export.Html]}" Click="ExportHtml_Click"/>
                            <MenuItem Header="{Binding Loc[Export.CsvHistory]}" Click="ExportHistoryCsv_Click"/>
                            <Separator/>
                            <MenuItem Header="{Binding Loc[Export.Compat]}" Click="CompatButton_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </DockPanel>
        </Border>
        <ListBox DockPanel.Dock="Left" x:Name="NavList" Width="200" BorderThickness="0,0,1,0"
                 ItemsSource="{Binding NavEntries}" SelectedValuePath="Page"
                 SelectedValue="{Binding CurrentPage, Mode=TwoWay}"
                 SelectionChanged="NavList_SelectionChanged"
                 Background="{DynamicResource NavBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                 Foreground="{DynamicResource NavTextBrush}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource NavTextBrush}"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" Padding="8,6" FontSize="14"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ContentControl x:Name="PageHost" Focusable="False"/>
    </DockPanel>
</Window>