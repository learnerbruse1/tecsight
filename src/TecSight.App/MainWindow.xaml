<Window x:Class="TecSight.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TecSight" Height="700" Width="1100" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen" FontSize="13" Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F2A44" Padding="14,8">
            <DockPanel>
                <TextBlock Text="{Binding Loc[App.Title]}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LangButton" Content="EN / 中文" Click="LangButton_Click" Margin="0,0,10,0" Padding="10,4"/>
                    <Button Content="{Binding Loc[Export.Json]}" Click="ExportJson_Click" Margin="0,0,6,0" Padding="10,4"/>
                    <Button Content="{Binding Loc[Export.Txt]}" Click="ExportTxt_Click" Padding="10,4"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ListBox DockPanel.Dock="Left" x:Name="NavList" Width="200" BorderThickness="0,0,1,0"
                 ItemsSource="{Binding NavEntries}" SelectedValuePath="Page"
                 SelectedValue="{Binding CurrentPage, Mode=TwoWay}"
                 SelectionChanged="NavList_SelectionChanged" Background="#F7F9FC">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" Padding="8,6" FontSize="14"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ContentControl x:Name="PageHost" Focusable="False"/>
    </DockPanel>
</Window>