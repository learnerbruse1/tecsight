<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#1E1E1E"/>
    <!-- 导航栏随主题变深色，文字浅色，保证可读 -->
    <SolidColorBrush x:Key="NavBgBrush" Color="#2A2A31"/>
    <SolidColorBrush x:Key="NavTextBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#383841"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#3D5A80"/>
    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="HeaderFgBrush" Color="#EDEDED"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#9A9A9A"/>
    <!-- 顶栏导出菜单：顶部项浅色文字适配深色头部；子菜单弹层保持浅色底+深色文字，保证可读 -->
    <Style TargetType="MenuItem">
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Foreground" Value="{DynamicResource HeaderFgBrush}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Foreground" Value="{DynamicResource HeaderFgBrush}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Foreground" Value="#14161A"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Foreground" Value="#14161A"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>