<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#1E1E1E"/>
    <!-- 导航栏保持灰白 + 深色文字，保证深色模式下可读 -->
    <SolidColorBrush x:Key="NavBgBrush" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="NavTextBrush" Color="#14161A"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="HeaderFgBrush" Color="#EDEDED"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#9A9A9A"/>
</ResourceDictionary>