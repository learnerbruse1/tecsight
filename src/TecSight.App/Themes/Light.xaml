<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavBgBrush" Color="#EEF2F8"/>
    <SolidColorBrush x:Key="NavTextBrush" Color="#1A2230"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E1E9F5"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#C9DAF7"/>
    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#1A2230"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#1F2A44"/>
    <SolidColorBrush x:Key="HeaderFgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#F2F5FA"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DCE3F0"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1A2230"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#5A6472"/>
    <!-- 顶栏导出菜单：顶部项浅色文字适配深色头部；子菜单弹层保持浅色底+深色文字，保证可读 -->
    <Style TargetType="MenuItem">
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Foreground" Value="{DynamicResource HeaderFgBrush}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Foreground" Value="{DynamicResource HeaderFgBrush}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Foreground" Value="#14161A"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Foreground" Value="#14161A"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>